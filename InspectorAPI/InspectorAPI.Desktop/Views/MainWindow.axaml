<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InspectorAPI.Core.ViewModels"
        xmlns:conv="using:InspectorAPI.Desktop.Converters"
        x:Class="InspectorAPI.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="InspectorAPI"
        Icon="avares://InspectorAPI/Assets/icon.ico"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource AppBg}">

  <Window.Styles>

    <!-- Sidebar button -->
    <Style Selector="Button.sidebar-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Button.sidebar-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionBg}" />
    </Style>

    <!-- Tab button -->
    <Style Selector="Button.tab-btn">
      <Setter Property="Background" Value="{DynamicResource TabbarBg}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- TreeViewItem drag visual -->
    <Style Selector="TreeViewItem.dragging">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="Button.tab-btn.active">
      <!-- SidebarBg matches the request-bar Border background exactly -->
      <Setter Property="Background" Value="{DynamicResource SidebarBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    </Style>
    <Style Selector="Button.tab-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBg}" />
    </Style>
    <!-- Active tab: suppress hover so it stays visually "connected" to content -->
    <Style Selector="Button.tab-btn.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SidebarBg}" />
    </Style>
    <!-- Active tab: underline the title text -->
    <Style Selector="Button.tab-btn.active TextBlock.tab-title">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- Close tab button -->
    <Style Selector="Button.close-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.close-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#CC3333" />
    </Style>

    <!-- Send / confirm button — layout only; colour comes from the Fluent "accent" class -->
    <Style Selector="Button.send-btn">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- New tab button -->
    <Style Selector="Button.new-tab-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontSize" Value="18" />
    </Style>

    <!-- Add row button -->
    <Style Selector="Button.add-row-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Margin" Value="8,4" />
    </Style>

    <!-- Remove row button -->
    <Style Selector="Button.remove-row-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Foreground" Value="{DynamicResource TextVeryFaint}" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Button.remove-row-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#AA2222" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <!-- TextBox base -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBg}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
      <Setter Property="CaretBrush">
        <Setter.Value>
          <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
        </Setter.Value>
      </Setter>
      <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
    </Style>

    <Style Selector="TextBox[AcceptsReturn=True]">
      <Setter Property="VerticalContentAlignment" Value="Top"></Setter>
    </Style>
    
    <!-- ComboBox base -->
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource InputBg}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    </Style>

    <!-- TabItem -->
    <Style Selector="TabItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- Tree item -->
    <Style Selector="TreeViewItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="AllowDrop" Value="True" />
    </Style>

    <!-- Method badge colors via classes -->
    <Style Selector="TextBlock.method-GET">
      <Setter Property="Foreground" Value="#61AFFE" />
    </Style>
    <Style Selector="TextBlock.method-POST">
      <Setter Property="Foreground" Value="#49CC90" />
    </Style>
    <Style Selector="TextBlock.method-PUT">
      <Setter Property="Foreground" Value="#FCA130" />
    </Style>
    <Style Selector="TextBlock.method-DELETE">
      <Setter Property="Foreground" Value="#F93E3E" />
    </Style>
    <Style Selector="TextBlock.method-PATCH">
      <Setter Property="Foreground" Value="#50E3C2" />
    </Style>
    <Style Selector="TextBlock.method-HEAD">
      <Setter Property="Foreground" Value="#9012FE" />
    </Style>
    <Style Selector="TextBlock.method-OPTIONS">
      <Setter Property="Foreground" Value="#0D5AA7" />
    </Style

  </Window.Styles>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" MinWidth="160" />
      <ColumnDefinition Width="4" />
      <ColumnDefinition Width="*"  MinWidth="460" />
    </Grid.ColumnDefinitions>

    <!-- ===== COLLECTIONS SIDEBAR ===== -->
    <DockPanel Grid.Column="0" Background="{DynamicResource SidebarBg}">

      <!-- Sidebar header -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBg}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderColor}"
              Padding="12,8">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0"
                     Text="COLLECTIONS"
                     FontSize="10" FontWeight="Bold"
                     Foreground="{DynamicResource TextLabel}"
                     VerticalAlignment="Center"
                     LetterSpacing="1" />
          <Button Grid.Column="1"
                  Classes="sidebar-btn"
                  Click="OnImportClick"
                  ToolTip.Tip="Import Collection (Native JSON format or Postman v2.1)"
                  FontSize="14" Padding="4,0">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="⬇" VerticalAlignment="Center" />
              <TextBlock Text="Import Collection" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2"
                  Classes="sidebar-btn"
                  Command="{Binding NewCollectionCommand}"
                  ToolTip.Tip="New Collection"
                  FontSize="18" Padding="4,0">+</Button>
        </Grid>
      </Border>

      <!-- Collections tree -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TreeView ItemsSource="{Binding CollectionTree}"
                  Background="Transparent"
                  KeyDown="OnCollectionTreeKeyDown"
                  AllowDrop="True"
                  DragOver="OnCollectionTreeDragOver"
                  Drop="OnCollectionTreeDrop">
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:CollectionTreeNodeViewModel"
                              ItemsSource="{Binding Children}">
              <!-- Transparent background needed so the full row width is hittable for the ContextMenu -->
              <Border Background="Transparent" HorizontalAlignment="Stretch"
                      DoubleTapped="OnTreeNodeDoubleTapped"
                      AllowDrop="True"
                      DragEnter="OnTreeNodeDragEnter"
                      DragLeave="OnTreeNodeDragLeave"
                      DragOver="OnTreeNodeDragOver"
                      Drop="OnTreeNodeDrop"
                      Classes="{x:Null}">

                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Open in Tab"
                              Command="{Binding OpenCommand}"
                              IsVisible="{Binding IsRequest}" />
                    <MenuItem Header="New Folder"
                              Command="{Binding NewFolderCommand}"
                              IsVisible="{Binding IsCollectionOrFolder}" />
                    <MenuItem Header="New Request"
                              Command="{Binding NewRequestCommand}"
                              IsVisible="{Binding IsCollectionOrFolder}" />
                    <MenuItem Header="Rename"
                              Command="{Binding RenameCommand}" />
                    <Separator IsVisible="{Binding IsCollection}" />
                    <MenuItem Header="Export (Native JSON)"
                              Command="{Binding ExportNativeCommand}"
                              IsVisible="{Binding IsCollection}" />
                    <MenuItem Header="Export (Postman v2.1)"
                              Command="{Binding ExportPostmanCommand}"
                              IsVisible="{Binding IsCollection}" />
                    <Separator />
                    <MenuItem Header="Delete"
                              Command="{Binding DeleteCommand}"
                              Foreground="#F93E3E" />
                  </ContextMenu>
                </Border.ContextMenu>

                <Grid ColumnDefinitions="Auto,*" Margin="0,1">

                  <!-- Icon / method badge -->
                  <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding Icon}"
                               FontSize="11"
                               Foreground="{DynamicResource TextLabel}"
                               IsVisible="{Binding IsNotRequest}" />
                    <TextBlock Text="{Binding MethodBadge}"
                               FontSize="9" FontWeight="Bold"
                               Foreground="{Binding MethodBadge, Converter={x:Static conv:MethodBrushConverter.Instance}}"
                               IsVisible="{Binding IsRequest}"
                               VerticalAlignment="Center" />
                  </StackPanel>

                  <!-- Node name -->
                  <TextBlock Grid.Column="1"
                             Text="{Binding Name}"
                             VerticalAlignment="Center"
                             Margin="4,0"
                             TextTrimming="CharacterEllipsis" />

                </Grid>
              </Border>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </ScrollViewer>
    </DockPanel>

    <!-- Vertical splitter -->
    <GridSplitter Grid.Column="1"
                  Background="{DynamicResource BorderColor}"
                  ResizeDirection="Columns" />

    <!-- ===== MAIN CONTENT ===== -->
    <Grid Grid.Column="2" RowDefinitions="Auto,*" Background="{DynamicResource AppBg}">

      <!-- Tab bar row -->
      <DockPanel Grid.Row="0" Background="{DynamicResource TabbarBg}"
                 LastChildFill="True">

        <!-- New tab button -->
        <Button DockPanel.Dock="Right"
                Classes="new-tab-btn"
                Command="{Binding AddNewTabCommand}"
                ToolTip.Tip="New Request"
                VerticalAlignment="Center">+</Button>

        <!-- Tab strip -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RequestTabViewModel">
                <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BorderColor}">
                  <Button Classes="tab-btn"
                          Classes.active="{Binding IsSelected}"
                          Command="{Binding ActivateCommand}">
                    <ToolTip.Tip>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Url}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFaint}"
                                   IsVisible="{Binding Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding SelectedMethod}"
                                 FontSize="10" FontWeight="Bold"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding SelectedMethod, Converter={x:Static conv:MethodBrushConverter.Instance}}" />
                      <TextBlock Text="{Binding TabTitle}"
                                 Classes="tab-title"
                                 MaxWidth="140"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <Button Classes="close-btn"
                              Command="{Binding CloseCommand}"
                              VerticalAlignment="Center">×</Button>
                    </StackPanel>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <!-- Tab content area -->
      <ContentControl Grid.Row="1" Content="{Binding SelectedTab}">
        <ContentControl.DataTemplates>
          <DataTemplate x:DataType="vm:RequestTabViewModel">

            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"   MinHeight="80" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" MinHeight="80" />
              </Grid.RowDefinitions>

              <!-- ===== REQUEST BAR ===== -->
              <Border Grid.Row="0" Padding="10,8"
                      Background="{DynamicResource SidebarBg}"
                      BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderColor}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" MinWidth="100" />
                    <ColumnDefinition Width="*"   MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!-- Method selector -->
                  <ComboBox Grid.Column="0"
                            ItemsSource="{x:Static vm:RequestTabViewModel.HttpMethods}"
                            SelectedItem="{Binding SelectedMethod}"
                            Padding="8,6"
                            FontWeight="Bold"
                            FontSize="13" />

                  <!-- URL input -->
                  <TextBox Grid.Column="1"
                           Text="{Binding Url}"
                           Watermark="https://api.example.com/endpoint"
                           Margin="6,0"
                           FontFamily="Consolas,Courier New,monospace"
                           FontSize="13"
                           Padding="10,6" />

                  <!-- Send button -->
                  <Button Grid.Column="2"
                          Classes="send-btn accent"
                          Command="{Binding SendRequestCommand}"
                          IsVisible="{Binding !IsSending}">Send</Button>

                  <!-- Cancel button -->
                  <Button Grid.Column="2"
                          Background="#AA3333"
                          Foreground="White"
                          BorderThickness="0"
                          Padding="12,8"
                          CornerRadius="4"
                          Command="{Binding CancelRequestCommand}"
                          IsVisible="{Binding IsSending}">Cancel</Button>

                  <!-- Save button -->
                  <Button Grid.Column="3"
                          Background="{DynamicResource SelectionBg}"
                          Foreground="{DynamicResource TextSecondary}"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource ButtonBorderColor}"
                          Padding="12,8"
                          CornerRadius="4"
                          Margin="6,0,0,0"
                          Command="{Binding OpenSaveDialogCommand}">Save</Button>

                  <!-- Duplicate tab button -->
                  <Button Grid.Column="4"
                          Background="{DynamicResource SelectionBg}"
                          Foreground="{DynamicResource TextSecondary}"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource ButtonBorderColor}"
                          Padding="12,8"
                          CornerRadius="4"
                          Margin="6,0,0,0"
                          ToolTip.Tip="Duplicate this tab"
                          Command="{Binding DuplicateCommand}">⧉</Button>

                </Grid>
              </Border>

              <!-- ===== REQUEST CONFIGURATION TABS ===== -->
              <TabControl Grid.Row="1" Background="{DynamicResource AppBg}">

                <!-- Headers tab -->
                <TabItem Header="Headers">
                  <Grid RowDefinitions="*,Auto" Background="{DynamicResource AppBg}">
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding Headers}" Margin="8,4">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:HeaderItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,*,Auto" Margin="0,2">
                              <CheckBox Grid.Column="0"
                                        IsChecked="{Binding IsEnabled}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0" />
                              <AutoCompleteBox Grid.Column="1"
                                              Text="{Binding Key}"
                                              ItemsSource="{x:Static vm:RequestTabViewModel.CommonHeaders}"
                                              MinimumPrefixLength="1"
                                              FilterMode="StartsWith"
                                              Watermark="Header name"
                                              FontFamily="Consolas,monospace"
                                              FontSize="12"
                                              Padding="6,4"
                                              Margin="0,0,4,0" />
                              <TextBox Grid.Column="2"
                                       Text="{Binding Value}"
                                       Watermark="Value"
                                       FontFamily="Consolas,monospace"
                                       FontSize="12"
                                       Padding="6,4" />
                              <Button Grid.Column="3"
                                      Classes="remove-row-btn"
                                      Command="{Binding RemoveCommand}"
                                      Margin="4,0,0,0">×</Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="1"
                            Classes="add-row-btn"
                            Command="{Binding AddHeaderCommand}">+ Add Header</Button>
                  </Grid>
                </TabItem>

                <!-- Query Params tab -->
                <TabItem Header="Query Params">
                  <Grid RowDefinitions="*,Auto" Background="{DynamicResource AppBg}">
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding QueryParams}" Margin="8,4">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:HeaderItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,*,Auto" Margin="0,2">
                              <CheckBox Grid.Column="0"
                                        IsChecked="{Binding IsEnabled}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0" />
                              <TextBox Grid.Column="1"
                                       Text="{Binding Key}"
                                       Watermark="Parameter name"
                                       FontFamily="Consolas,monospace"
                                       FontSize="12"
                                       Padding="6,4"
                                       Margin="0,0,4,0" />
                              <TextBox Grid.Column="2"
                                       Text="{Binding Value}"
                                       Watermark="Value"
                                       FontFamily="Consolas,monospace"
                                       FontSize="12"
                                       Padding="6,4" />
                              <Button Grid.Column="3"
                                      Classes="remove-row-btn"
                                      Command="{Binding RemoveCommand}"
                                      Margin="4,0,0,0">×</Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="1"
                            Classes="add-row-btn"
                            Command="{Binding AddQueryParamCommand}">+ Add Parameter</Button>
                  </Grid>
                </TabItem>

                <!-- Body tab -->
                <TabItem Header="Body">
                  <Grid RowDefinitions="Auto,*" Background="{DynamicResource AppBg}">

                    <!-- Content-Type selector -->
                    <Border Grid.Row="0"
                            Padding="8,6"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource BorderColor}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Content-Type:"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding BodyContentTypes}"
                                  SelectedItem="{Binding SelectedBodyContentType}"
                                  FontSize="12"
                                  Padding="8,4" />
                      </StackPanel>
                    </Border>

                    <!-- Form URL-encoded: key-value list -->
                    <Grid Grid.Row="1" RowDefinitions="*,Auto"
                          Background="{DynamicResource AppBg}"
                          IsVisible="{Binding IsFormUrlEncodedBody}">
                      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FormParams}" Margin="8,4">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HeaderItemViewModel">
                              <Grid ColumnDefinitions="Auto,*,*,Auto" Margin="0,2">
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsEnabled}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding Key}"
                                         Watermark="Name"
                                         FontFamily="Consolas,monospace"
                                         FontSize="12"
                                         Padding="6,4"
                                         Margin="0,0,4,0" />
                                <TextBox Grid.Column="2"
                                         Text="{Binding Value}"
                                         Watermark="Value"
                                         FontFamily="Consolas,monospace"
                                         FontSize="12"
                                         Padding="6,4" />
                                <Button Grid.Column="3"
                                        Classes="remove-row-btn"
                                        Command="{Binding RemoveCommand}"
                                        Margin="4,0,0,0">×</Button>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <Button Grid.Row="1"
                              Classes="add-row-btn"
                              Command="{Binding AddFormParamCommand}">+ Add Parameter</Button>
                    </Grid

                  <!-- Auth tab (placeholder) -->
                  <TabItem Header="Auth">
                    <Border Background="{DynamicResource AppBg}" Padding="16">
                      <StackPanel Spacing="12">
                        <TextBlock Text="Authentication" FontSize="14" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFaint}">
                          Add Authorization headers manually in the Headers tab.<LineBreak/>
                          Common patterns:&#10;<LineBreak/>
                          • Bearer token: Authorization: Bearer &lt;token&gt;&#10;<LineBreak/>
                          • Basic auth: Authorization: Basic &lt;base64&gt;&#10;<LineBreak/>
                          • API key: X-Api-Key: &lt;key&gt;
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </TabItem>

                  <!-- Editable raw HTTP request -->
                  <TabItem Header="Raw">
                    <TextBox Text="{Binding RequestRaw}"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas,Courier New,monospace"
                             FontSize="13"
                             Padding="12"
                             Background="{DynamicResource AppBg}"
                             BorderThickness="0"
                             Watermark="Paste or edit your raw HTTP request here…"
                             AcceptsTab="True" />
                  </TabItem>

                </TabControl>

            </Grid>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>

    </Grid>

  </Grid>

</Window>